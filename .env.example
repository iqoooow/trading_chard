# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Maxfiy! Faqat serverda ishlatiladi, hech qachon NEXT_PUBLIC_ qilmang
SUPABASE_SERVICE_ROLE_KEY=

# TwelveData API kaliti (https://twelvedata.com)
TWELVEDATA_API_KEY=

# /api/cron/daily ni himoyalaydi (Authorization: Bearer <CRON_SECRET>). Production (Vercel) da majburiy,
# lokal dev da ixtiyoriy. Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Saytni login/parol bilan yopadi (HTTP Basic Auth). Production (Vercel) da majburiy: SITE_PASSWORD
# bo'lmasa sayt ochilmaydi (503). Lokal dev da ixtiyoriy.
SITE_USERNAME=
SITE_PASSWORD=
